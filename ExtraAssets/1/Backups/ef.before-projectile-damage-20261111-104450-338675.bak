  {
    "uid": 37,
    "name": "毒刺攻击",
    "code": "朝向敌人(param1);\nCharacterPlayAnim(param1, \"攻击\");\nposRaw = GetCharacterPosition(param1);\nfor (i = -0.5; i <= 0; i = i + 1)\n{\n    pos = posRaw + NewVector(0, 0, 0.2);\n    newObject = GenerateObject(\"$so$79$so$\", pos);\n    SetSceneObjectParameter(newObject, \"所属人物\", param1);\n    tar = GetCharacterForwardVector(param1);\n    tar.x = tar.x * 0.4;\n    tar.y = tar.y * 0.4;\n    SetSceneObjectParameter(newObject, \"移动方向\", tar);\n    SetObjectRotation(newObject, GetCharacterRotation(param1), 0);\n}\n",
