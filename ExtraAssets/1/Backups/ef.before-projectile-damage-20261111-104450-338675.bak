    "uid": 41,
    "name": "幽灵e技能",
    "code": "CharacterChat(param1, \"\", \"$i$88$i$\", 3);\nCharacterStun(param1, 1.5);\nWait(1);\nfor (i = 1; i <= 2; i = i + 1)\n{\n    Wait(0.2);\n    pos = GetCharacterPosition(param1);\n    pos.height = pos.height + 0.5;\n    for (j = 0; j < 360; j = j + 60)\n    {\n        newObject = GenerateObject(\"$so$1550$so$\", pos);\n        SetSceneObjectParameter(newObject, \"所属人物\", param1);\n        SetObjectRotation(newObject, j + i * 30, 0);\n        tar = GetObjectForwardVector(newObject);\n        tar = tar * 0.3;\n        SetSceneObjectParameter(newObject, \"移动方向\", tar);\n    }\n}\n",
