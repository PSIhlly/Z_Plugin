  {
    "uid": 14,
    "name": "敌人索敌攻击",
    "code": "for (times = 1; times <= 2; times++)\n{\nif(IsStun(param1))\n{\nreturn;\n}\n    selfPos = GetCharacterPosition(param1);\n    selfPos.height = selfPos.height + 0.6;\n    lst = GetCharactersInArea(selfPos, 10);\n    len = Len(lst);\n    for (i = 0; i < len; i = i + 1)\n    {\n        if (是敌对(lst[i], param1))\n        {\n            tarPos = GetCharacterPosition(lst[i]);\n            tarPos.height = tarPos.height + 0.6;\n            if (GetVectorLength(tarPos - selfPos) + 0.5 < GetCharacterParameter(param1, \"射程\") && IsUnobstructed(tarPos, selfPos, 0.4))\n            {\n                StopCharacterNavigate(param1);\n                SetCharacterRotation(param1, GetLookAtRotation(selfPos, tarPos), 0.1);\n                UseCharacterLightAttack(param1, 0);\n                UseCharacterESkill(param1, 0);\n                UseCharacterQSkill(param1, 0);\n                Return result;\n            }\n            else\n            {\n                SetCharacterNavigate(param1, GetCharacterPosition(lst[i]));\n                SetCharacterRotation(param1, GetLookAtRotation(GetCharacterPosition(param1), GetCharacterPosition(lst[i])), 0);\n                break;\n            }\n        }\n    }\n    Wait(0.5);\n}\n",
