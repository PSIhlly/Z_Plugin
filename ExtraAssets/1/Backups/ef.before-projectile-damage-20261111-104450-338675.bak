  {
    "uid": 10,
    "name": "子弹碰撞销毁",
    "code": "if (IsObjectEnableCollision(param2))\n{\n    ShowEffect(\"$ef$1$ef$\", GetObjectPosition(param1), 0);\n    hp = GetSceneObjectParameter(param2, \"可破坏\");\n    if (hp > 0)\n    {\n        hp = hp - GetCharacterParameter(GetSceneObjectParameter(param1, \"所属人物\"), \"攻击\");\n        SetSceneObjectParameter(param2, \"可破坏\", hp);\n        if (hp <= 0)\n        {\n            景物毁坏(param2);\n        }\n    }\n    DestroyObject(param1);\n}\n",
