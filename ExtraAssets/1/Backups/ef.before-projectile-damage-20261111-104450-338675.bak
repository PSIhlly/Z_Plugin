  {
    "uid": 8,
    "name": "子弹打人",
    "code": "if (GetSceneObjectParameter(param1, \"所属人物\") != param2)\n{\n    if (是敌对(GetSceneObjectParameter(param1, \"所属人物\"), param2))\n    {\n        damage = GetCharacterParameter(GetSceneObjectParameter(param1, \"所属人物\"), \"攻击\") - GetCharacterParameter(param2, \"防御\");\n        if (damage < 0)\n        {\n            damage = 0;\n        }\n        SetCharacterParameter(param2, \"Hp\", GetCharacterParameter(param2, \"Hp\") - damage);\n    }\n    ShowEffect(\"$ef$1$ef$\", GetCharacterPosition(param2), 0);\n    PlayAudio(\"$a$55$a$\");\n    DestroyObject(param1);\n}\n",
