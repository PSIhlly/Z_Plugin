  {
    "uid": 28,
    "name": "朝向敌人",
    "code": "origin = GetPosition(param1);\norigin.height = origin.height + 0.5;\ncharacters = GetCharactersInArea(origin, 10);\nnearest = \"\";\nnearestDistance = 10;\nfor (i = 0; i < Len(characters); i = i + 1)\n{\n    candidate =characters[i]; \n    tarPos = GetPosition(candidate);\n    tarPos.height = tarPos.height + 0.5;\n    if (candidate != param1 && 是敌对(candidate, param1) && IsUnobstructed(origin, tarPos, 0.2))\n    {\n        distance = GetVectorLength(tarPos - origin);\n        if (distance < nearestDistance)\n        {\n            nearest = candidate;\n            nearestDistance = distance;\n        }\n    }\n}\nif (nearest != \"\")\n{\n    SetRotation(param1, GetLookAtRotation(origin, GetPosition(nearest)), 0);\n}\n",
