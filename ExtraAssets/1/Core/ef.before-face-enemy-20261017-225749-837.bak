    "code": "弹图(\"$i$972$i$\");\nShowEffectByCharacter(\"$ef$3$ef$\", param1, 1);\nfor (i = 0; i <= 13; i = i + 1)\n{\n    Wait(0.1);\n    for (j = -0.2; j <= 0.2; j = j + 0.4)\n    {\n        pos = GetCharacterPosition(param1) + NewVector(0, 0, 0.2) + GetCharacterRightVector(param1) * j;\n        newObject = GenerateObject(\"$sop$17$sop$\", pos);\n        SetSceneObjectParameter(newObject, \"所属人物\", param1);\n        SetSceneObjectParameter(newObject, \"移动方向\", GetCharacterForwardVector(param1));\n        SetObjectRotation(newObject, GetCharacterRotation(param1), 0);\n    }\n}\n",
