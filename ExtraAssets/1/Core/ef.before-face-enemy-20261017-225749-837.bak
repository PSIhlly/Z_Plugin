    "code": "chs = GetCharactersInArea(GetCharacterPosition(param1), 1.3);\nlen = Len(chs);\nfor (tar = 0; tar < len; tar = tar + 1)\n{\n    if (是敌对(chs[tar], param1))\n    {\n        damage = GetCharacterParameter(param1, \"攻击\") - GetCharacterParameter(chs[tar], \"防御\");\n        if (damage < 0)\n        {\n            damage = 0;\n        }\n        SetCharacterParameter(chs[tar], \"Hp\", GetCharacterParameter(chs[tar], \"Hp\") - damage);\n    }\n}\n",
