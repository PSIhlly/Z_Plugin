  {
    "uid": 7,
    "name": "子弹追踪",
    "code": "dir = GetSceneObjectParameter(param1, \"移动方向\");\ndir.height = 0;\ndir = GetNormalizedVector(dir);\nMoveObjectRelative(param1, dir, 0.3);\nfor (a = 0; a < 19; a = a + 1)\n{\n    chs = GetCharactersInArea(GetObjectPosition(param1), 3);\n    len = Len(chs);\n    for (tar = 0; tar < len; tar = tar + 1)\n    {\n        if (GetCharacterParameter(chs[tar] ,\"Team\")!= GetCharacterParameter(GetSceneObjectParameter(param1, \"所属人物\"),\"Team\"))\n        {\n            dir = GetCharacterPosition(chs[tar]) - GetObjectPosition(param1);\n            dir.height = 0;\n            SetObjectRotation(param1, GetLookAtRotation(GetObjectPosition(param1), GetCharacterPosition(chs[tar])), 0.1);\n            tar = len;\n        }\n    }\n    dir = GetNormalizedVector(dir);\n    MoveObjectRelative(param1, dir, 0.3);\n}\nDestroyObject(param1);\n",
