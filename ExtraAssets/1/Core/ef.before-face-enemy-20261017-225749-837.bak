  {
    "uid": 14,
    "name": "敌人索敌",
    "code": "lst = GetCharactersInArea(GetCharacterPosition(param1), 10);\nlen = Len(lst);\nfor (i = 0; i < len; i = i + 1)\n{\n    if (是敌对(lst[i], param1))\n    {\n        if (GetVectorLength(GetCharacterPosition(lst[i]) - GetCharacterPosition(param1)) + 0.5 < GetCharacterParameter(param1, \"射程\") && IsUnobstructed(GetCharacterPosition(lst[i]), GetCharacterPosition(param1), 0.3))\n        {\n            ShowTip(\"找到\");\n            StopCharacterNavigate(param1);\n            return;\n        }\n        else\n        {\n            SetCharacterNavigate(param1, GetCharacterPosition(lst[i]));\n            SetCharacterRotation(param1, GetLookAtRotation(GetCharacterPosition(param1), GetCharacterPosition(lst[i])), 0);\n            break;\n        }\n    }\n}\n",
