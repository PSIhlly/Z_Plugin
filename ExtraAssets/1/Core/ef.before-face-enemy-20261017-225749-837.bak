  {
    "uid": 13,
    "name": "魔符·星屑幻想",
    "code": "ShowEffectByCharacter(\"$ef$2$ef$\", param1, 1);\nfor (i = 1; i <= 2; i = i + 1)\n{\n    Wait(0.2);\n    pos = GetCharacterPosition(param1);\n    pos.height = pos.height + 0.2;\n    for (j = 0; j < 360; j = j + 30)\n    {\n        newObject = GenerateObject(\"$sop$17$sop$\", pos);\n        SetSceneObjectParameter(newObject, \"所属人物\", param1);\n        SetObjectRotation(newObject, j, 0);\n        SetSceneObjectParameter(newObject, \"移动方向\", GetObjectForwardVector(newObject));\n    }\n}\n",
